{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@nexus/character-creator": [
        "../../packages/character-creator/src/index.ts"
      ],
      "@nexus/character-creator/*": [
        "../../packages/character-creator/src/*"
      ],
      "@nexus/game-contracts": [
        "../../packages/game-contracts/src/index.ts"
      ],
      "@nexus/game-contracts/*": [
        "../../packages/game-contracts/src/*"
      ],
      "@nexus/rules-contracts": [
        "../../packages/rules-contracts/src/index.ts"
      ],
      "@nexus/rules-contracts/*": [
        "../../packages/rules-contracts/src/*"
      ],
      "@nexus/rules-5e": [
        "../../packages/rules-5e/src/index.ts"
      ],
      "@nexus/rules-5e/*": [
        "../../packages/rules-5e/src/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "shared/**/*",
    "postcss.config.cjs"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}