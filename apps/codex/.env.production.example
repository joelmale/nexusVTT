# NexusCodex Production Environment Variables
# Copy this file to Portainer Stack Environment Variables

# ============================================
# GitHub Container Registry Configuration
# ============================================
GITHUB_REPO_OWNER=YOUR_GITHUB_USERNAME
IMAGE_TAG=latest

# ============================================
# Database Configuration
# ============================================
POSTGRES_DB=doclib
POSTGRES_USER=nexuscodex
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ============================================
# MinIO (S3-Compatible Storage)
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ============================================
# Authentication & Security
# ============================================
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_RANDOM_32_CHAR_STRING

# ============================================
# Service URLs (Update with your domain)
# ============================================
DOC_API_URL=http://your-domain.com:3005
WEBSOCKET_URL=ws://your-domain.com:3002

# ============================================
# Optional: Production Overrides
# ============================================
# NODE_ENV=production
# LOG_LEVEL=info
# SESSION_TTL=3600

# ============================================
# Optional: ElasticSearch Configuration
# ============================================
# ES_JAVA_OPTS=-Xms512m -Xmx512m

# ============================================
# Optional: Redis Configuration
# ============================================
# REDIS_PASSWORD=your-redis-password
