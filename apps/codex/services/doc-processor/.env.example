# Node Environment
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/doclib

# Redis
REDIS_URL=redis://localhost:6379

# ElasticSearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=documents

# S3-Compatible Storage Configuration
# Development (MinIO): Use values below
# Production (GCS): See DEPLOYMENT_GCP.md for GCS HMAC setup
#   S3_ENDPOINT=https://storage.googleapis.com
#   S3_ACCESS_KEY=<GCS_HMAC_ACCESS_KEY>
#   S3_SECRET_KEY=<GCS_HMAC_SECRET>
#   S3_BUCKET=<your-gcs-bucket-name>
#   S3_REGION=us-central1
#   S3_FORCE_PATH_STYLE=false
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password
S3_BUCKET=documents
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Processing Configuration
QUEUE_NAME=document-processing
ASSET_QUEUE_NAME=document-assets
WORKER_CONCURRENCY=2
ASSET_WORKER_CONCURRENCY=1
THUMBNAIL_WIDTH=300
THUMBNAIL_QUALITY=80
PAGE_IMAGE_WIDTH=1200
PAGE_IMAGE_QUALITY=80
PAGE_IMAGE_MAX_PAGES=200
OCR_MAX_PAGES=50
OCR_WORKER_POOL_SIZE=2
OCR_TEXT_MIN_CHARS=50
OCR_TEXT_MIN_WORDS=10

# Embeddings
EMBEDDINGS_PROVIDER=none
EMBEDDINGS_DIM=64
EMBEDDINGS_BATCH_SIZE=20

# Logging
LOGGING_ENABLED=true
LOGGING_INDEX=nexus-logs
LOGGING_SERVICE_NAME=doc-processor
