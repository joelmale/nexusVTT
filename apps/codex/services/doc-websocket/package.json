{
  "name": "nexus-codex-doc-websocket",
  "version": "1.0.0",
  "description": "Nexus VTT Document WebSocket Service for Real-time Collaboration",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run src/__tests__/*.integration.test.ts"
  },
  "keywords": [
    "nexus",
    "vtt",
    "websocket",
    "realtime"
  ],
  "author": "Nexus VTT",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "@elastic/elasticsearch": "^9.5.1",
    "express": "^5.2.1",
    "ws": "^8.16.0",
    "ioredis": "^5.3.2",
    "uuid": "^14.0.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/ws": "^8.5.10",
    "@types/jest": "^29.5.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "prisma": "^5.7.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
