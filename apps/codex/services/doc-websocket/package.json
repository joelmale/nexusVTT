{
  "name": "nexus-codex-doc-websocket",
  "version": "1.0.0",
  "description": "Nexus VTT Document WebSocket Service for Real-time Collaboration",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run src/__tests__/*.integration.test.ts"
  },
  "keywords": [
    "nexus",
    "vtt",
    "websocket",
    "realtime"
  ],
  "author": "Nexus VTT",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^14.0.2",
    "ws": "^8.16.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.5.10",
    "jest": "^30.5.2",
    "prisma": "^5.7.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3"
  }
}
