{
    "name": "nexus-codex-doc-api",
    "version": "1.0.0",
    "description": "Nexus VTT Document Library API Service",
    "main": "dist/server.js",
    "engines": {
        "node": ">=22.0.0",
        "npm": ">=10.0.0"
    },
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:studio": "prisma studio",
        "prisma:push": "prisma db push",
        "test": "npm run test:unit",
        "test:unit": "vitest run --config vitest.config.ts",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:integration": "vitest run --config vitest.integration.config.ts",
        "db:create-admin": "tsx src/scripts/create-admin.ts",
        "import:5e-srd": "tsx src/scripts/import-5e-srd.ts",
        "import:5e-srd:dry-run": "tsx src/scripts/import-5e-srd.ts --dry-run",
        "import:5e-srd:spells": "tsx src/scripts/import-5e-srd.ts --types spells",
        "import:5e-srd:monsters": "tsx src/scripts/import-5e-srd.ts --types monsters",
        "import:5e-srd:help": "tsx src/scripts/import-5e-srd.ts --help",
        "rules:srd-compare": "tsx src/scripts/rules-srd-compare.ts"
    },
    "keywords": [
        "nexus",
        "vtt",
        "document",
        "library"
    ],
    "author": "Nexus VTT",
    "license": "MIT",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.477.0",
        "@aws-sdk/s3-request-presigner": "^3.477.0",
        "@elastic/elasticsearch": "^9.5.1",
        "@fastify/cors": "^11.3.0",
        "@fastify/jwt": "^10.2.2",
        "@fastify/multipart": "^10.1.1",
        "@nexus/document-contracts": "*",
        "@nexus/rules-contracts": "*",
        "@prisma/client": "^5.22.0",
        "@types/prompts": "^2.4.9",
        "bcryptjs": "^3.0.3",
        "bullmq": "^5.81.5",
        "dotenv": "^16.3.1",
        "fastify": "^5.12.5",
        "file-type": "^22.1.1",
        "ioredis": "^5.3.2",
        "jsonwebtoken": "^9.0.2",
        "prom-client": "^15.1.3",
        "prompts": "^2.4.2",
        "sharp": "^0.35.4",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/bcryptjs": "^3.0.0",
        "@types/jest": "^29.5.11",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/node": "^26.6.2",
        "@types/sharp": "^0.32.0",
        "jest": "^29.7.0",
        "prisma": "^5.7.1",
        "ts-jest": "^29.1.1",
        "tsx": "^4.20.6",
        "typescript": "^5.3.3"
    }
}
