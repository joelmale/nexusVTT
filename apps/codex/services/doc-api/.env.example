# Node Environment
NODE_ENV=development
PORT=3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/doclib

# Redis
REDIS_URL=redis://localhost:6379

# ElasticSearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=documents

# S3-Compatible Storage Configuration
# Development (MinIO): Use values below
# Production (GCS): See DEPLOYMENT_GCP.md for GCS HMAC setup
#   S3_ENDPOINT=https://storage.googleapis.com
#   S3_ACCESS_KEY=<GCS_HMAC_ACCESS_KEY>
#   S3_SECRET_KEY=<GCS_HMAC_SECRET>
#   S3_BUCKET=<your-gcs-bucket-name>
#   S3_REGION=us-central1
#   S3_FORCE_PATH_STYLE=false
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=admin
S3_SECRET_KEY=password
S3_BUCKET=documents
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# API Configuration
UPLOAD_URL_EXPIRY=3600
DOWNLOAD_URL_EXPIRY=3600
MAX_FILE_SIZE=104857600

# Logging
LOGGING_ENABLED=true
LOGGING_INDEX=nexus-logs
LOGGING_SERVICE_NAME=doc-api
AUTH_DISABLED=true
EMBEDDINGS_PROVIDER=none
EMBEDDINGS_DIM=64
LLM_PROVIDER=none
LLM_MODEL=
