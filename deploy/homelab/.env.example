# Homelab Compose environment template for deploy/homelab/compose.yaml
#
# Copy to .env only for local render validation. Dockhand keeps production
# credentials in its encrypted environment store; never commit a real .env,
# and never paste production secrets into this file.
#
# Every variable the compose file references is listed below, grouped by
# purpose. "Required" means the compose file uses ${VAR:?...} or ${VAR} with
# no fallback -- omitting it fails `docker compose config`/`up` immediately.
# "Optional" variables have a working default baked into compose.yaml.

# ==============================================================================
# Secrets (required -- no defaults in compose.yaml; the stack fails loudly if
# any of these are missing rather than booting with a known-weak credential)
# ==============================================================================

# PostgreSQL password for POSTGRES_USER. Shared by the VTT and Codex databases.
POSTGRES_PASSWORD=replace-with-production-postgres-password

# Redis AUTH password (--requirepass). Shared by VTT (db 0) and Codex (db 1).
REDIS_PASSWORD=replace-with-production-redis-password

# Full backend Postgres connection string, e.g.
# postgresql://<user>:<password>@postgres:5432/<db>
DATABASE_URL=postgresql://nexus:replace-with-production-postgres-password@postgres:5432/nexus

# Backend JWT signing secret (session tokens / API auth).
JWT_SECRET=replace-with-production-jwt-secret

# Backend Express session cookie signing secret.
SESSION_SECRET=replace-with-production-session-secret

# Google OAuth client secret (paired with GOOGLE_CLIENT_ID below).
GOOGLE_CLIENT_SECRET=replace-with-production-google-client-secret

# Discord OAuth client secret (paired with DISCORD_CLIENT_ID below).
DISCORD_CLIENT_SECRET=replace-with-production-discord-client-secret

# Shared secret the backend and asset-server use to authenticate
# service-to-service asset requests.
ASSET_SERVICE_SECRET=replace-with-production-asset-service-secret

# MinIO root username backing Codex document storage (also used as the
# S3_ACCESS_KEY by doc-api/doc-processor). No default -- "minioadmin" is a
# well-known weak credential and must not ship as a fallback.
CODEX_MINIO_ROOT_USER=replace-with-production-codex-minio-user

# MinIO root password backing Codex document storage (also used as the
# S3_SECRET_KEY by doc-api/doc-processor).
CODEX_MINIO_ROOT_PASSWORD=replace-with-production-codex-minio-password

# JWT signing secret for the Codex doc-api/doc-websocket services.
CODEX_JWT_SECRET=replace-with-production-codex-jwt-secret

# ==============================================================================
# Required, non-secret configuration (no default -- must match the deployment
# environment; a wrong default here could weaken CORS/OAuth behavior)
# ==============================================================================

# Origin the backend allows for CORS (the public frontend URL).
CORS_ORIGIN=https://app.nexusvtt.com

# Google OAuth client ID.
GOOGLE_CLIENT_ID=replace-with-production-google-client-id

# Google OAuth callback URL registered with Google.
GOOGLE_CALLBACK_URL=https://app.nexusvtt.com/auth/google/callback

# Discord OAuth client ID.
DISCORD_CLIENT_ID=replace-with-production-discord-client-id

# Discord OAuth callback URL registered with Discord.
DISCORD_CALLBACK_URL=https://app.nexusvtt.com/auth/discord/callback

# ==============================================================================
# Storage (optional -- defaults match the live NAS layout)
# ==============================================================================

# Host directory root for all bind-mounted volumes (Postgres data, Redis
# data, asset libraries, TMT seed data). Every path is <root>/<subdir>.
# Optional; defaults to the live NAS mount.
NEXUS_STORAGE_ROOT=/mnt/docker-nas-vol1/nexusvtt

# ==============================================================================
# Networking (optional -- defaults are sane for a single-host deployment)
# ==============================================================================

# Postgres database name used by the VTT app. Optional, defaults to "nexus".
POSTGRES_DB=nexus

# Postgres role used by both VTT and Codex. Optional, defaults to "nexus".
POSTGRES_USER=nexus

# Postgres database name used by Codex doc services on the shared instance.
# Optional, defaults to "doclib".
CODEX_POSTGRES_DB=doclib

# Public URL clients use to reach the Codex MinIO S3 API (presigned URLs).
# Optional, defaults to http://localhost:9000.
CODEX_S3_PUBLIC_ENDPOINT=http://localhost:9000

# ==============================================================================
# Images (optional -- default to the currently verified/pinned tags; override
# only to test a different build without editing compose.yaml)
# ==============================================================================

POSTGRES_IMAGE=ghcr.io/joelmale/nexusvtt/postgres:latest
REDIS_IMAGE=redis:7-alpine
ASSET_SERVICE_IMAGE=ghcr.io/joelmale/nexusvtt/asset-service:latest
NEXUS_FORGE_IMAGE=ghcr.io/joelmale/nexus-forge:master
FRONTEND_IMAGE=ghcr.io/joelmale/nexusvtt/frontend:latest
BACKEND_IMAGE=ghcr.io/joelmale/nexusvtt/backend:latest
CODEX_ELASTICSEARCH_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:9.5.3
CODEX_MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
DOC_API_IMAGE=ghcr.io/joelmale/nexuscodex-doc-api:main
DOC_PROCESSOR_IMAGE=ghcr.io/joelmale/nexuscodex-doc-processor:main
DOC_WEBSOCKET_IMAGE=ghcr.io/joelmale/nexuscodex-doc-websocket:main
ADMIN_UI_IMAGE=ghcr.io/joelmale/nexuscodex-admin-ui:main
DM_UI_IMAGE=ghcr.io/joelmale/nexuscodex-dm-ui:main

# ==============================================================================
# Optional
# ==============================================================================

# Developer tooling switch: registers /api/dev/* seeding and teardown routes
# on the backend. Optional, defaults to false; do not enable in production.
DEV_MODE=false

# Bearer token for the Prometheus scrape endpoint GET /metrics.
# Optional. When empty or unset, /metrics is served WITHOUT any auth check
# (see the `if (configuredToken && ...)` guard in apps/vtt/server/index.ts) --
# set this to require `Authorization: Bearer <token>` in production.
# NOTE: this token guards /metrics only. The JSON endpoints
# /api/metrics/multiplayer, /api/metrics/realtime and
# /api/metrics/ordered-events are unauthenticated regardless of this value,
# so none of these routes should be reachable from outside the reverse proxy.
METRICS_AUTH_TOKEN=replace-with-production-metrics-token

# Multiplayer SLO thresholds surfaced by /api/metrics/multiplayer. All
# optional; defaults match server/config production thresholds.
MULTIPLAYER_SLO_COMMIT_P95_MS=250
MULTIPLAYER_SLO_RESYNC_RATE_RATIO=0.01
MULTIPLAYER_SLO_QUEUE_DEPTH=100
MULTIPLAYER_SLO_HEAP_UTILIZATION_RATIO=0.9

# ==============================================================================
# Phase 3 rehearsal overlay (deploy/homelab/compose.rehearsal.yaml)
# ==============================================================================
# Disposable rehearsal-only values. Never replace these with live secrets;
# see deploy/homelab/README.md before running a rehearsal.
REHEARSAL_POSTGRES_DB=nexus_rehearsal
REHEARSAL_POSTGRES_USER=nexus_rehearsal
REHEARSAL_POSTGRES_PASSWORD=nexus-rehearsal
REHEARSAL_REDIS_PASSWORD=nexus-rehearsal
REHEARSAL_CORS_ORIGIN=http://nexus-migration-phase3-e078895.invalid
REHEARSAL_JWT_SECRET=nexus-migration-phase3-e078895-jwt
REHEARSAL_SESSION_SECRET=nexus-migration-phase3-e078895-session
REHEARSAL_GOOGLE_CLIENT_ID=rehearsal-disabled
REHEARSAL_GOOGLE_CLIENT_SECRET=rehearsal-disabled
REHEARSAL_GOOGLE_CALLBACK_URL=http://nexus-migration-phase3-e078895.invalid/auth/google/callback
REHEARSAL_DISCORD_CLIENT_ID=rehearsal-disabled
REHEARSAL_DISCORD_CLIENT_SECRET=rehearsal-disabled
REHEARSAL_DISCORD_CALLBACK_URL=http://nexus-migration-phase3-e078895.invalid/auth/discord/callback
REHEARSAL_ASSET_SERVICE_SECRET=nexus-rehearsal-assets
REHEARSAL_METRICS_AUTH_TOKEN=nexus-migration-phase3-e078895-metrics
REHEARSAL_CODEX_POSTGRES_DB=doclib_rehearsal
REHEARSAL_CODEX_MINIO_ROOT_USER=nexus-rehearsal
REHEARSAL_CODEX_MINIO_ROOT_PASSWORD=nexus-rehearsal
REHEARSAL_CODEX_JWT_SECRET=nexus-migration-phase3-e078895-codex-jwt
