{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "nexus-vtt"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "server:dev", "--workspace", "nexus-vtt"],
      "port": 5001
    },
    {
      "name": "forge",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "nexus-forge"],
      "port": 3000
    }
  ]
}
