{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "nexus-vtt"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "server:dev", "--workspace", "nexus-vtt"],
      "port": 5001
    },
    {
      "name": "asset-service",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "export ASSET_SERVICE_SECRET=$(grep '^ASSET_SERVICE_SECRET=' apps/vtt/.env | cut -d= -f2-) PORT=5003 && npx tsx apps/vtt/services/asset-service/src/index.ts"
      ],
      "port": 5003
    },
    {
      "name": "dm-ui",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "@nexuscodex/dm-ui"],
      "port": 3003
    },
    {
      "name": "forge",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--workspace", "nexus-forge"],
      "port": 3000
    }
  ]
}
