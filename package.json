{
  "name": "nexus-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Repository-level orchestration for the Nexus applications",
  "workspaces": [
    "packages/*",
    "apps/vtt",
    "apps/vtt/apps/generator-hub",
    "apps/vtt/services/asset-service",
    "apps/forge",
    "apps/docs",
    "apps/control-api",
    "apps/codex/services/admin-ui",
    "apps/codex/services/dm-ui",
    "apps/codex/services/doc-api",
    "apps/codex/services/doc-processor",
    "apps/codex/services/doc-websocket"
  ],
  "scripts": {
    "install:all": "npm ci",
    "install:vtt": "npm ci --workspace=nexus-vtt --workspace=generator-hub --workspace=asset-service --workspace=@nexus/character-contracts --workspace=@nexus/game-contracts --workspace=@nexus/rules-contracts --workspace=@nexus/rules-5e --workspace=@nexus/character-creator --include-workspace-root",
    "install:forge": "npm ci --workspace=nexus-forge --workspace=@nexus/character-contracts --workspace=@nexus/game-contracts --workspace=@nexus/character-creator --include-workspace-root",
    "install:codex": "npm ci --workspace=nexus-codex-doc-api --workspace=nexus-codex-doc-processor --workspace=nexus-codex-doc-websocket --workspace=admin-ui --workspace=@nexuscodex/dm-ui --workspace=@nexus/rules-contracts --include-workspace-root",
    "install:docs": "npm ci --workspace=@nexus/docs --include-workspace-root",
    "build:contracts": "npm run build --workspace=@nexus/character-contracts && npm run build --workspace=@nexus/document-contracts && npm run build --workspace=@nexus/game-contracts && npm run build --workspace=@nexus/rules-5e && npm run build --workspace=@nexus/rules-contracts && npm run build --workspace=@nexus/character-creator",
    "build:vtt": "npm run build:contracts && npm run build:all --workspace=nexus-vtt",
    "build:forge": "npm run build:contracts && npm run build --workspace=nexus-forge",
    "build:codex": "npm run build:contracts && npm run prisma:generate --workspace=nexus-codex-doc-api && npm run build --workspace=nexus-codex-doc-api && npm run prisma:generate --workspace=nexus-codex-doc-processor && npm run build --workspace=nexus-codex-doc-processor && npm run prisma:generate --workspace=nexus-codex-doc-websocket && npm run build --workspace=nexus-codex-doc-websocket && npm run build --workspace=admin-ui && npm run build --workspace=@nexuscodex/dm-ui",
    "start:docs": "npm run start --workspace=@nexus/docs",
    "build:docs": "npm run build --workspace=@nexus/docs",
    "type-check": "npm run build:contracts && npm run type-check --workspace=@nexus/character-creator && npm run type-check --workspace=nexus-vtt && npm exec --workspace=nexus-forge tsc -- --noEmit && npm run build:codex",
    "check:workspace-lock": "node scripts/validate-workspace-lock.mjs",
    "check:docker-build-contracts": "node scripts/ci/validate-docker-build-contracts.mjs",
    "build:workspace-deps": "node scripts/build-workspace-dependencies.mjs",
    "branches:audit": "node scripts/branch-hygiene.mjs",
    "report:ci-timing": "node scripts/ci/report-actions-timing.mjs",
    "test:ci-report": "vitest run --config scripts/ci/vitest.actions-timing.config.mjs",
    "test:affected-targets": "vitest run --config scripts/ci/affected-targets.vitest.config.mjs",
    "test:coverage-manifest": "vitest run scripts/ci/coverage-manifest.test.mjs",
    "test:vtt": "npm run test:ci --workspace=nexus-vtt",
    "test:character-creator": "npm run test --workspace=@nexus/character-creator",
    "test:rules-contracts": "npm run test --workspace=@nexus/rules-contracts",
    "test:game-contracts": "npm run test --workspace=@nexus/game-contracts",
    "test:rules-5e": "npm run test --workspace=@nexus/rules-5e",
    "test:forge": "npm run lint --workspace=nexus-forge && npm run test --workspace=nexus-forge -- --run --coverage",
    "test:codex": "npm run test --workspace=nexus-codex-doc-api && npm run test --workspace=nexus-codex-doc-processor && npm run test --workspace=nexus-codex-doc-websocket",
    "test:docs": "npm run typecheck --workspace=@nexus/docs && npm run build:docs",
    "test:codex:integration": "npm run test:integration --workspace=nexus-codex-doc-api"
  },
  "overrides": {
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "image-size": "2.0.4",
    "lodash-es": "^4.18.1",
    "qs": "6.16.0",
    "serialize-javascript": "7.1.1",
    "sockjs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "ajv": "^8.20.0"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.3",
    "@img/sharp-libvips-linuxmusl-x64": "1.3.3",
    "@img/sharp-linux-x64": "0.35.4",
    "@img/sharp-linuxmusl-x64": "0.35.4",
    "@rolldown/binding-linux-x64-gnu": "1.2.8",
    "@rolldown/binding-linux-x64-musl": "1.2.8",
    "@rollup/rollup-linux-x64-gnu": "4.63.2",
    "@rollup/rollup-linux-x64-musl": "4.63.2",
    "@rspack/binding-linux-x64-gnu": "1.7.12",
    "@rspack/binding-linux-x64-musl": "1.7.12",
    "@swc/core-linux-x64-gnu": "1.16.2",
    "@swc/core-linux-x64-musl": "1.16.2",
    "@swc/html-linux-x64-gnu": "1.16.2",
    "@swc/html-linux-x64-musl": "1.16.2",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "4.3.3",
    "lightningcss-linux-x64-gnu": "1.33.0",
    "lightningcss-linux-x64-musl": "1.33.0"
  },
  "allowScripts": {
    "@3d-dice/dice-box@1.1.4": false,
    "@parcel/watcher@2.6.0": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "canvas@3.2.3": true,
    "core-js-pure@3.50.0": false,
    "core-js@3.50.0": false,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@5.22.0": true,
    "sharp@0.33.5": true,
    "tesseract.js@5.1.1": false,
    "unrs-resolver@1.12.2": true
  }
}
